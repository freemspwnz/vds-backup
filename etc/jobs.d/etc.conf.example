#!/usr/bin/env bash

# Second example job on the same host (different paths / repo / password).
# Sourced as bash — only use trusted job files.

JOB_NAME="etc"
JOB_ENABLED=0

REPO_PATH="/srv/restic/etc"
# BACKEND=sftp   # or rest; inherits global default


BACKUP_PATHS=(
  /etc
)

EXCLUDES=()

RESTIC_TAGS="scheduled,etc"

SQLITE_DUMP_ENABLED=0
POSTGRES_DUMP_ENABLED=0

# RESTIC_PASSWORD_FILE="/usr/local/etc/backup/secrets/etc.pass"
