#!/usr/bin/env bash

# Example job: one restic repository = one backup set.
# Copy to jobs.d/home.conf (or any name) and edit.
# Sourced as bash — only use trusted job files.

JOB_NAME="home"
JOB_ENABLED=1

# Inherit global BACKEND (sftp|rest), or override per job:
# BACKEND=rest

# Path of the repository on the remote (SFTP: absolute path; REST: URL path segment)
REPO_PATH="/srv/restic/home"
# Or full override (BACKEND inferred from scheme):
# RESTIC_REPOSITORY="sftp:backup@backup.example.com:/srv/restic/home"
# RESTIC_REPOSITORY="rest:https://backup.example.com:8000/home/"

# Optional: override global SFTP_* for this job (BACKEND=sftp)
# SFTP_HOST=...
# SFTP_PORT=...
# SFTP_IDENTITY=...

# Optional: override global REST_* for this job (BACKEND=rest)
# REST_SCHEME=https
# REST_HOST=...
# REST_PORT=8000
# REST_PATH_PREFIX=
# RESTIC_CACERT=...

# Optional: password for this repo only (else global RESTIC_PASSWORD from .env)
# RESTIC_PASSWORD="job-specific-secret"
# RESTIC_PASSWORD_FILE="/usr/local/etc/backup/secrets/home.pass"

BACKUP_PATHS=(
  /home/user/data
  /home/user/documents
)

EXCLUDES=(
  /home/user/data/cache
  /home/user/data/tmp
)

RESTIC_TAGS="scheduled,home"
# RESTIC_HOST="$(hostname)"

SQLITE_DUMP_ENABLED=0
# SQLITE_SCAN_ROOTS=(/home/user/data)
# SQLITE_DB_FILES=()

POSTGRES_DUMP_ENABLED=0
# POSTGRES_DOCKER_CONTAINER="postgres"
# POSTGRES_DUMP_USER="postgres"

# KEEP_DAILY=14
# DO_FORGET_AFTER_BACKUP=1
# DO_CHECK_AFTER_BACKUP=0
# CHECK_WEEKDAY=7
