#!/usr/bin/env bash

# Global defaults for backup-utils (Linux client).
# Install path: /usr/local/etc/backup/backup.conf
# Per-repo jobs: /usr/local/etc/backup/jobs.d/*.conf
# Secrets: /usr/local/etc/backup/.env (RESTIC_PASSWORD, TG_*) — job may override password.
#
# SECURITY: this file and jobs.d/*.conf are sourced as bash (arbitrary code).
# Only install configs you trust; keep ownership root:root and mode 640.

JOBS_DIR="/usr/local/etc/backup/jobs.d"

# Default SFTP target (job may override)
SFTP_HOST="backup.example.com"
SFTP_PORT=22
SFTP_USER="backup"
SFTP_IDENTITY="/root/.ssh/id_ed25519"
# SFTP_COMMAND="ssh -p 22 -i /root/.ssh/id_ed25519 -o BatchMode=yes backup@backup.example.com -s sftp"

BACKUP_TMP_BASE_DIR="/var/tmp"
LOCK_DIR_BASE="/var/run/backup"

RESTIC_BIN=restic

# Default retention (job may override)
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=3

# After successful backup in `backup.sh run`
DO_FORGET_AFTER_BACKUP=1
# Always run restic check after backup (1) or only on CHECK_WEEKDAY
DO_CHECK_AFTER_BACKUP=0
# ISO weekday for weekly check: 1=Mon … 7=Sun; 0 = disable weekday schedule
CHECK_WEEKDAY=7

# LOG_FILE="/var/log/backup.log"
# DEBUG_FLG=1
