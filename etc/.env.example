# Secrets (chmod 600). Install path: /usr/local/etc/backup/.env
# Default password for all jobs unless a job overrides.

RESTIC_PASSWORD="CHANGE_ME"

# HTTP Basic auth for rest-server (BACKEND=rest); optional
# REST_USER="backup"
# REST_PASS="CHANGE_ME_REST"

# Optional Telegram HTML reports
# TG_TOKEN="123456:ABC..."
# TG_CHAT_ID="-100..."
